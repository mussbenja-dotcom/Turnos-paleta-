# Base de datos
DATABASE_URL=postgres://usuario:password@localhost:5432/padel
# Poné DB_SSL=true SOLO en la nube (Railway/Render). En local dejalo en false.
DB_SSL=false

# Servidor
PORT=3000
ENABLE_CRON=true
TZ_OFFSET=-03:00

# WhatsApp Cloud API (Meta)
WA_TOKEN=EAAG...tu_token_de_acceso
WA_PHONE_ID=1234567890
WA_API_VERSION=v21.0
WA_VERIFY_TOKEN=mi_token_secreto_para_el_webhook
